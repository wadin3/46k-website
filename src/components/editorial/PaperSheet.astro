---
interface Props { number: number; byline: string; variant?: string; }
const { number, byline, variant = 'reading' } = Astro.props;
---
<section class={`paper-sheet paper-${variant} surface-${number % 3}`} data-paper-page={number}>
  <div class="paper-running" aria-hidden="true"><span>{byline}</span><span>DECODING FOOTBALL INTELLIGENCE</span></div>
  <slot />
  <div class="paper-folio" aria-hidden="true"><span>46K</span><span>{number}</span></div>
</section>
