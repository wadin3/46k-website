---
interface Props { label: string; items: { id: string; title: string; number: number }[]; }
const { label, items } = Astro.props;
---
{items.length > 0 && <nav class="story-contents container" aria-label={label}><p class="kicker">{label}</p><ol>{items.map(item => <li><a href={'#' + item.id}><span>{String(item.number).padStart(2, '0')}</span>{item.title}</a></li>)}</ol></nav>}
