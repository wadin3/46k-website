---
import { translate, localePath, type Locale } from '../../i18n';
import { getArticles, articleSlug } from '../../lib/articles';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const t = (text: string) => translate(locale, text);
const href = (route = '') => localePath(route, locale);
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { getCollection } from 'astro:content';
import { sitePath } from '../../lib/paths';
const features = [
  { name: t("UNDERSTAND"), body: t("Look beyond what happens on the pitch. Explore perception, cognition and the questions behind football intelligence."), path: 'explore/', link: t("Explore our thinking") },
  { name: t("ASSESS"), body: t("We are developing ways to examine relevant cognitive capabilities. Research and validation come first."), path: 'assessment/', link: t("Our approach to assessment") },
  { name: t("DEVELOP"), body: t("Turn insights into better questions about training and development. Measurement should lead somewhere useful."), path: 'explore/?category=DEVELOP', link: t("Explore development") },
];
const articles = (await getArticles(locale)).slice(0, 3);
---
<EditorialLayout locale={locale}>
  <main id="main-content">
    <section class="home-hero">
      <img class="hero-image" src={sitePath('images/football-attention-editorial.webp')} alt={t('Illustrative image of an adult football player looking across a training pitch.')} width="1536" height="1024" fetchpriority="high" />
      <div class="container hero-content">
        <p class="kicker">{t("46K / SWEDEN / FOOTBALL INTELLIGENCE")}</p>
        <span class="line"></span>
        <h1 class="serif">{t("Football")}<br />{t("intelligence.")}</h1>
        <p class="hero-statement">{t("Talent is more than")}<br />{t("what you can see today.")}</p>
        <p class="hero-deck">{t("We use cognitive science to understand and develop football intelligence.")}</p>
        <a class="button-link" href={href('explore/')}>{t("Explore our thinking")} <span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>
    <section class="home-model container">
      <p class="kicker">{t("A WAY OF THINKING")}</p>
      <div class="model-grid">{features.map((feature, index) => <article>
        <span class="step-number">0{index + 1}</span><h2>{feature.name}</h2><p>{feature.body}</p><a class="text-link" href={href(feature.path)}>{feature.link} <span aria-hidden="true">&#8599;</span></a>
      </article>)}</div>
    </section>
    <section class="home-journal container">
      <div class="section-heading"><div><p class="kicker">{t("THE JOURNAL")}</p><h2 class="serif">{t("Questions worth asking.")}</h2></div><a class="text-link" href={href('explore/')}>{t("All articles")} <span aria-hidden="true">&#8599;</span></a></div>
      <div class="article-grid">{articles.map(article => <article class="article-card"><p class="meta">{t(article.data.category)} / {article.data.readingTime} {t("MIN READ")}</p><h3><a href={href('explore/' + articleSlug(article) + '/')}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="read" href={href('explore/' + articleSlug(article) + '/')}>{t("Read article")} <span aria-hidden="true">&#8599;</span></a></article>)}</div>
    </section>
    <section class="mission-band"><div class="container"><p class="kicker">{t("THE 2046 MISSION")}</p><span class="line"></span><h2 class="serif">{t("Sweden.")}<br />{t("World Champions.")}<br />2046.</h2><p>{t("2046 is not a prediction. It is a direction.")}</p><a class="text-link" href={href('mission/')}>{t("Explore the ambition")} <span aria-hidden="true">&#8599;</span></a></div></section>
  </main>
</EditorialLayout>
