---
import { translate, localePath, type Locale } from '../../i18n';
import { getArticles, articleSlug } from '../../lib/articles';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import ArticleCarousel from '../ArticleCarousel.astro';
import { sitePath } from '../../lib/paths';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const t = (text: string) => translate(locale, text);
const href = (route = '') => localePath(route, locale);
const features = [
  { name: t('UNDERSTAND'), body: t("We use neuropsychological research to understand football intelligence in depth. Which fundamental psychological characteristics influence how a player's brain perceives the game around them and makes decisions on the pitch?"), path: 'explore/', link: t('Explore our thinking') },
  { name: t('MEASURE'), body: t('We develop psychometric tests that measure the abilities underlying football intelligence. This helps players discover their strengths and areas for development.'), path: 'assessment/', link: t('Our approach to assessment') },
  { name: t('DEVELOP'), body: t("We combine test results with knowledge of training methods from football and psychology to provide practical advice and exercises for each player's individual development."), path: 'explore/?category=DEVELOP', link: t('Explore development') },
];
const articles = await getArticles(locale);
---
<EditorialLayout locale={locale} description={t('We explore the science behind football intelligence – and create tools that help players understand their potential and develop on the pitch.')}>
  <main id="main-content">
    <section class="home-hero">
      <img class="hero-image" src={sitePath('images/football-intelligence-male.webp')} alt={t('Illustrative image of an adult male football player scanning a training pitch.')} width="1536" height="1024" fetchpriority="high" />
      <div class="container hero-content">
        <p class="kicker hero-eyebrow">{t('NEUROPSYCHOLOGY x FOOTBALL')}</p>
        <span class="line"></span>
        <h1 class="serif"><span>{t('Football Intelligence')}</span>{' '}<span>{t('Decoded')}</span></h1>
        <p class="hero-statement">{t('Talent is more than physique and technique')}</p>
        <p class="hero-deck">{t('We explore the science behind football intelligence – and create tools that help players understand their potential and develop on the pitch.')}</p>
        <a class="button-link" href={href('explore/')}>{t('Explore our thinking')} <span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>
    <section class="home-model container">
      <p class="kicker" data-reveal>{t('What we do')}</p>
      <div class="model-grid">{features.map((feature, index) => <article data-reveal>
        <span class="step-number">0{index + 1}</span><h2>{feature.name}</h2><p>{feature.body}</p><a class="text-link" href={href(feature.path)}>{feature.link} <span aria-hidden="true">&#8599;</span></a>
      </article>)}</div>
    </section>
    <section class="home-journal">
      <div class="container">
        <div class="section-heading" data-reveal><div><p class="kicker">{t('THE JOURNAL')}</p><h2 class="serif">{t('Understand more about football intelligence.')}</h2></div><a class="text-link" href={href('explore/')}>{t('All articles')} <span aria-hidden="true">&#8599;</span></a></div>
        <ArticleCarousel articles={articles} locale={locale} />
      </div>
    </section>
    <section class="mission-band home-mission"><div class="container">
      <p class="kicker" data-reveal>2046</p><span class="line"></span>
      <h2 class="serif" data-reveal>{t('Sweden, Football World Champions 2046')}</h2>
      <p data-reveal>{t('It began with an unreasonable ambition.')}</p>
      <a class="text-link" href={href('mission/')}>{t('Explore the ambition')} <span aria-hidden="true">&#8599;</span></a>
    </div></section>
  </main>
</EditorialLayout>
<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (!reducedMotion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('has-arrived');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    reveals.forEach(element => observer.observe(element));
  }
</script>
