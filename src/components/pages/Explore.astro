---
import { translate, localePath, type Locale } from '../../i18n';
import { getArticles, articleSlug, readingMinutes } from '../../lib/articles';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const t = (text: string) => translate(locale, text);
const href = (route = '') => localePath(route, locale);
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { getCollection } from 'astro:content';
import { sitePath } from '../../lib/paths';
import { assetPath } from '../../lib/paths';
const articles = await getArticles(locale);
const cats=['ALL','UNDERSTAND','ASSESS','DEVELOP','2046'];
---
<EditorialLayout locale={locale} title={t("Explore — 46K")} description={t("Ideas, research and perspectives on football intelligence.")}>
<main id="main-content" class="container"><section class="journal-intro"><div class="kicker">{t("46K / THE JOURNAL")}</div><span class="line"></span><h1 class="serif">{t("Explore.")}</h1><p>{t("Better questions. Deeper understanding. New perspectives on the unseen side of football.")}</p></section>
<nav class="filters" aria-label={t("Article categories")}>{cats.map(c=><a href={href(c==='ALL'?'explore/':'explore/?category='+c)} data-cat={c} aria-current={c==='ALL'?'page':undefined}>{t(c)}</a>)}</nav>
<p id="empty-category" class="empty-state" hidden role="status">{t("No articles in this category yet.")} <a class="text-link" href={href('explore/')}>{t("Explore all articles")}</a></p>
<div class="article-grid" id="articles">{articles.map(article=><article class="article-card" data-category={article.data.category}>{article.data.heroImage && <img class="listing-photo" src={assetPath(article.data.heroImage)} alt="" width="1536" height="1024" loading="lazy" />}<div class="meta">{t(article.data.category)} / {t(article.data.type.toUpperCase())} / {readingMinutes(article)} MIN</div><h2><a href={href('explore/'+articleSlug(article)+'/')}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="read" href={href('explore/'+articleSlug(article)+'/')}>{t("READ ARTICLE")} <span aria-hidden="true">↗</span></a></article>)}</div>
</main>
<script>
  const categories = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-cat]')).map(link => link.dataset.cat);
  const requested = new URLSearchParams(window.location.search).get('category')?.toUpperCase() ?? 'ALL';
  const category = categories.includes(requested) ? requested : 'ALL';
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  let visible = 0;
  cards.forEach(card => {
    card.hidden = category !== 'ALL' && card.dataset.category !== category;
    if (!card.hidden) visible++;
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-cat]').forEach(link => {
    if (link.dataset.cat === category) link.setAttribute('aria-current', 'page');
    else link.removeAttribute('aria-current');
  });
  const empty = document.getElementById('empty-category');
  if (empty) empty.hidden = visible !== 0;
</script>
<style>.article-card[hidden]{display:none}</style>
</EditorialLayout>
