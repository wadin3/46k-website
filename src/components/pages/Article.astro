---
import { translate, localePath, locales, type Locale } from '../../i18n';
import { getArticles, articleSlug } from '../../lib/articles';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const t = (text: string) => translate(locale, text);
const href = (route = '') => localePath(route, locale);
import { getCollection, render } from 'astro:content';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { sitePath, assetPath } from '../../lib/paths';
const {article}=Astro.props;
const {Content}=await render(article);
const all = await getArticles(locale);
const related=all.filter(a=>a.id!==article.id&&(a.data.category===article.data.category||a.data.type===article.data.type)).slice(0,2);
const d=article.data;
const languageRoutes = Object.fromEntries(await Promise.all((Object.keys(locales) as Locale[]).map(async language => {
  const match = (await getArticles(language)).find(other => (other.data.translationKey ?? articleSlug(other)) === (d.translationKey ?? articleSlug(article)));
  return [language, localePath(match ? 'explore/' + articleSlug(match) + '/' : 'explore/', language)];
})));
---
<EditorialLayout locale={locale} languageRoutes={languageRoutes} title={d.title+' — 46K'} description={d.description}>
<main id="main-content" class={'type-'+d.type}><section class="article-hero"><div class="container"><a href={href('explore/')} class="kicker"><span aria-hidden="true">←</span> {t("BACK TO EXPLORE")}</a><span class="line"></span><p class="kicker">{t(d.category)} / {t(d.type.toUpperCase())}</p><h1>{d.title}</h1><p class="deck">{d.description}</p><div class="details"><span>46K / DECODING FOOTBALL INTELLIGENCE</span><span>{d.date.toLocaleDateString(locale === 'sv' ? 'sv-SE' : 'en-GB',{day:'2-digit',month:'short',year:'numeric'})} · {d.readingTime} {t("MIN READ")}</span></div></div></section>
{d.heroImage&&<div class="container"><img class="article-photo" src={assetPath(d.heroImage)} alt={d.heroAlt??''}/></div>}
<article class="article-body"><Content/></article>
{d.sources.length>0&&<section class="references"><h2>{t("Sources & further reading")}</h2><ol>{d.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a></li>)}</ol></section>}
{related.length>0&&<section class="related"><div class="container"><p class="kicker">{t("KEEP EXPLORING")}</p>{related.map(a=><a href={href('explore/'+articleSlug(a)+'/')}>{a.data.title} ↗</a>)}</div></section>}
</main></EditorialLayout>
