---
import { localePath, type Locale } from '../../i18n';
import { missionContent, missionChapterIds } from '../../data/mission';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { sitePath } from '../../lib/paths';
import ChapterLabel from '../mission/ChapterLabel.astro';
import Paragraphs from '../mission/Paragraphs.astro';
import Method from '../mission/Method.astro';
import '../../styles/mission.css';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const c = missionContent(locale);
const href = (route: string) => localePath(route, locale);
---
<EditorialLayout locale={locale} title={c.title} description={c.description}>
  <main id="main-content" class="mission-story" style={`--print-plate: url('${sitePath('images/editorial-ink-plate.webp')}')`}>
    <section id="dream" data-mission-chapter aria-labelledby="mission-title">
      <div class="mission-cover">
        <img class="mission-cover-image" src={sitePath('images/mission-arena.webp')} width="1919" height="820" alt={c.hero.imageAlt} fetchpriority="high" />
        <div class="container mission-cover-content">
          <ChapterLabel number="01" label={c.chapters[0]} />
          <h1 id="mission-title"><span>{c.hero.country}</span><span class="cover-champions">{c.hero.champions}</span><span class="cover-year">2046<span class="year-stop">.</span></span></h1>
          <p class="cover-deck">{c.hero.deck}</p>
          <a class="text-link" href="#origin">{c.hero.begin}<span aria-hidden="true">&#8595;</span></a>
        </div>
      </div>
      <div id="origin" class="mission-origin mission-paper">
        <div class="container mission-editorial-grid">
          <div class="mission-origin-heading" data-mission-reveal><span class="line"></span><h2 class="serif">{c.origin.lead}</h2></div>
          <div class="mission-prose"><Paragraphs items={c.origin.paragraphs} /></div>
        </div>
      </div>
    </section>
    <nav class="mission-chapters" aria-label={c.chapterLabel}>
      <ol>{missionChapterIds.map((id, index) => <li><a href={`#${id}`} data-mission-link><span>0{index + 1}</span>{c.chapters[index]}</a></li>)}</ol>
    </nav>
    <section id="problem" data-mission-chapter class="mission-problem mission-paper" aria-labelledby="problem-title">
      <div class="container">
        <ChapterLabel number="02" label={c.chapters[1]} />
        <h2 id="problem-title" class="mission-heading serif" data-mission-reveal>{c.problem.title}</h2>
        <div class="mission-problem-grid">
          <figure class="mission-problem-photo" data-mission-reveal><img src={sitePath('images/mission-training.webp')} width="1536" height="1024" alt={c.problem.imageAlt} loading="lazy" /></figure>
          <div class="mission-prose"><Paragraphs items={c.problem.paragraphs} /></div>
        </div>
        <p class="mission-equation" data-mission-reveal><span>{c.problem.present}</span><span class="equation-symbol" aria-label={locale === 'sv' ? 'är inte samma sak som' : 'is not the same as'}>≠</span><span>{c.problem.future}</span></p>
      </div>
    </section>
    <section id="opportunity" data-mission-chapter class="mission-opportunity" aria-labelledby="opportunity-title">
      <div class="container"><ChapterLabel number="03" label={c.chapters[2]} /><h2 id="opportunity-title" class="mission-heading serif" data-mission-reveal>{c.opportunity.title}</h2></div>
      <figure class="mission-perception" data-mission-reveal>
        <img src={sitePath('images/football-ground-hero-v4.webp')} width="1920" height="819" alt={c.opportunity.imageAlt} loading="lazy" />
        <ol class="perception-signals">{c.opportunity.signals.map(label => <li>{label}</li>)}</ol>
        <figcaption class="container">{c.opportunity.caption}</figcaption>
      </figure>
      <div class="container mission-editorial-grid mission-opportunity-copy"><p class="mission-question serif" data-mission-reveal>{c.opportunity.paragraphs[0]}</p><div class="mission-prose"><Paragraphs items={c.opportunity.paragraphs.slice(1)} /></div></div>
    </section>
    <section id="expertise" data-mission-chapter class="mission-expertise mission-paper" aria-labelledby="expertise-title">
      <div class="container">
        <ChapterLabel number="04" label={c.chapters[3]} />
        <div class="mission-expertise-grid">
          <div><h2 id="expertise-title" class="mission-heading serif" data-mission-reveal>{c.expertise.title}</h2><div class="mission-prose"><Paragraphs items={c.expertise.paragraphs} /></div></div>
          <figure data-mission-reveal><img src={sitePath('images/editorial-feedback.webp')} width="1536" height="1024" alt={c.expertise.imageAlt} loading="lazy" /><span class="line" aria-hidden="true"></span><p class="expertise-photo-note serif">{c.expertise.paragraphs[4]}</p></figure>
        </div>
      </div>
    </section>
    <section id="method" data-mission-chapter class="mission-method-section" aria-labelledby="method-title">
      <div class="container">
        <ChapterLabel number="05" label={c.chapters[4]} />
        <div class="mission-editorial-grid"><h2 id="method-title" class="mission-heading serif" data-mission-reveal>{c.method.title}</h2><div class="mission-prose"><Paragraphs items={c.method.intro} /></div></div>
        <Method steps={c.method.steps} />
        <p class="method-bridge serif" data-mission-reveal>{c.method.bridge}</p>
        <div class="method-caveat mission-prose"><Paragraphs items={c.method.outro} /></div>
      </div>
    </section>
    <section id="road" data-mission-chapter class="mission-road-section mission-paper" aria-labelledby="road-title">
      <div class="container">
        <ChapterLabel number="06" label={c.chapters[5]} />
        <div class="mission-editorial-grid"><h2 id="road-title" class="mission-heading serif" data-mission-reveal>{c.road.title}</h2><div class="mission-prose"><p>{c.road.intro}</p></div></div>
        <blockquote class="mission-deadline serif" data-mission-reveal>{c.road.quote}</blockquote>
        <div class="mission-road-copy mission-prose"><Paragraphs items={c.road.paragraphs} /></div>
      </div>
      <img class="mission-road-photo" src={sitePath('images/editorial-ground.webp')} width="1536" height="1024" alt="" loading="lazy" />
    </section>
    <section id="journey" data-mission-chapter class="mission-finale" aria-labelledby="journey-title">
      <img class="mission-finale-image" src={sitePath('images/mission-arena.webp')} width="1919" height="820" alt="" loading="lazy" />
      <div class="container">
        <ChapterLabel number="07" label={c.chapters[6]} />
        <h2 id="journey-title" class="mission-heading serif" data-mission-reveal>{c.journey.title}</h2>
        <div class="mission-finale-copy"><p class="finale-question serif">{c.journey.question}</p><div class="mission-prose"><Paragraphs items={c.journey.paragraphs} /></div>
          <h3 class="mission-follow-heading serif">{c.journey.followHeading}</h3>
          <p class="mission-invitation">{c.journey.invitation}</p>
          <a class="mission-contact text-link" href={href('connect/')}>{c.journey.contact}<span aria-hidden="true">&#8599;</span></a>
        </div>
        <div class="mission-signoff" data-mission-reveal><img src={sitePath('brand/logos/46K_FullSignature_Dark.png')} width="2172" height="724" alt="46K — Decoding Football Intelligence" loading="lazy" /><p class="serif">{c.journey.signoff.split(c.journey.signoffAccent)[0]}<span class="signoff-gold">{c.journey.signoffAccent}</span>{c.journey.signoff.split(c.journey.signoffAccent)[1]}</p></div>
      </div>
    </section>
    <div class="mission-disclosure container"><p>{c.disclosure}</p></div>
  </main>
</EditorialLayout>
<script>
  const story = document.querySelector<HTMLElement>('.mission-story');
  if (story) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const revealTargets = story.querySelectorAll<HTMLElement>('[data-mission-reveal]');
    if (!motion.matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('mission-arrived');
          observer.unobserve(entry.target);
        }
      }), { threshold: .12 });
      revealTargets.forEach(target => observer.observe(target));
    }
    const chapters = Array.from(story.querySelectorAll<HTMLElement>('[data-mission-chapter]'));
    const links = Array.from(story.querySelectorAll<HTMLAnchorElement>('[data-mission-link]'));
    let scheduled = false;
    let activeId = '';
    const updateChapter = () => {
      scheduled = false;
      const current = chapters.filter(chapter => chapter.getBoundingClientRect().top <= innerHeight * .4).at(-1) ?? chapters[0];
      links.forEach(link => {
        if (link.hash === '#' + current.id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (current.id !== activeId) {
        const active = links.find(link => link.hash === '#' + current.id);
        const rail = active?.closest('ol');
        if (active && rail) {
          const item = active.getBoundingClientRect();
          const viewport = rail.getBoundingClientRect();
          if (item.left < viewport.left + 12 || item.right > viewport.right - 12) {
            rail.scrollTo({ left: rail.scrollLeft + item.left - viewport.left - (rail.clientWidth - item.width) / 2, behavior: motion.matches ? 'auto' : 'smooth' });
          }
        }
        activeId = current.id;
      }
    };
    addEventListener('scroll', () => {
      if (!scheduled) { scheduled = true; requestAnimationFrame(updateChapter); }
    }, { passive: true });
    addEventListener('resize', updateChapter);
    updateChapter();
  }
</script>
