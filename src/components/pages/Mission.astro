---
import { translate, localePath, type Locale } from '../../i18n';
import { getArticles, articleSlug } from '../../lib/articles';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const t = (text: string) => translate(locale, text);
const href = (route = '') => localePath(route, locale);
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { sitePath } from '../../lib/paths';
---
<EditorialLayout locale={locale} title={t("The 2046 Mission - 46K")} description={t("What would it take for Sweden to win the World Cup in 2046? A direction for research and development.")}>
  <main id="main-content">
    <section class="page-intro container"><p class="kicker">{t("THE FOUNDING QUESTION")}</p><span class="line"></span><h1 class="serif mission-title">{t("Sweden.")}<br />{t("World Champions.")}<br />2046.</h1><p class="page-deck">{t("2046 is not a prediction. It is a direction.")}</p></section>
    <section class="mission-band"><div class="container two-column"><h2 class="serif">{t("An unreasonable")}<br />{t("ambition.")}</h2><div class="prose"><p>{t("What would it take for Sweden to win the World Cup in 2046?")}</p><p>{t("We use that question to look at how football understands and develops talent. What can cognitive science contribute? What are we missing when we focus only on what is visible today?")}</p><p>{t("The ambition sets a direction. The work is to ask useful questions, test our assumptions and stay honest about what the evidence supports.")}</p><a class="text-link" href={href('explore/?category=2046')}>{t("Read the 2046 perspective")} <span aria-hidden="true">&#8599;</span></a></div></div></section>
    <section class="page-close container"><p class="kicker">{t("UNDERSTAND / ASSESS / DEVELOP")}</p><h2 class="serif">{t("A longer view of talent.")}</h2><a class="button-link" href={href('explore/')}>{t("Explore our thinking")} <span aria-hidden="true">&#8599;</span></a></section>
  </main>
</EditorialLayout>
