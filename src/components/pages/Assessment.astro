---
import { localePath, type Locale } from '../../i18n';
import copy from '../../data/assessment.json';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import ValueCard from '../assessment/ValueCard.astro';
import ProductShowcase from '../assessment/ProductShowcase.astro';
import { sitePath } from '../../lib/paths';
import '../../styles/assessment.css';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const c = copy[locale];
const evidence = ['WE KNOW', 'EVIDENCE SUGGESTS', 'WE THINK'];
---
<EditorialLayout locale={locale} title={c.title} description={c.description}>
  <main id="main-content" class="assessment-page" style={`--assessment-print: url('${sitePath('images/editorial-ink-plate.webp')}')`}>
    <section class="assessment-hero" id="start" aria-labelledby="assessment-title">
      <img class="assessment-hero-image" src={sitePath('images/assessment-hero.webp')} width="1672" height="941" alt={c.hero.alt} fetchpriority="high" />
      <div class="container assessment-hero-content">
        <p class="kicker assessment-eyebrow">{c.hero.eyebrow}</p>
        <span class="line" aria-hidden="true"></span>
        <h1 class="serif" id="assessment-title"><span>{c.hero.lines[0]}</span>{' '}<em>{c.hero.lines[1]}</em></h1>
        <p class="assessment-hero-deck">{c.hero.body}</p>
        <a class="button-link assessment-gold-button" href="#why">{c.hero.action}<span aria-hidden="true">&#8599;</span></a>
        <p class="assessment-status">{c.hero.status}</p>
      </div>
    </section>
    <section class="assessment-why" id="why" aria-labelledby="assessment-why-title">
      <div class="container">
        <p class="kicker assessment-section-label">{c.why.eyebrow}</p>
        <div class="assessment-why-grid">
          <div data-assessment-reveal>
            <h2 class="serif" id="assessment-why-title">{c.why.title}</h2>
            <div class="assessment-why-copy">{c.why.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
            <blockquote class="serif">{c.why.quote}</blockquote>
          </div>
          <figure class="assessment-visual" data-assessment-reveal>
            <img src={sitePath('images/assessment-visualize.webp')} width="1448" height="1086" alt={c.why.alt} loading="lazy" />
            <figcaption>{c.why.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section class="assessment-value" id="audience" aria-labelledby="assessment-value-title">
      <div class="container">
        <div class="assessment-value-intro" data-assessment-reveal>
          <p class="kicker assessment-section-label">{c.value.eyebrow}</p>
          <h2 class="serif" id="assessment-value-title">{c.value.title}</h2>
          <p class="assessment-value-deck">{c.value.intro.map(line => <span>{line}</span>)}</p>
        </div>
        <div class="assessment-value-grid">{c.value.cards.map(card => <ValueCard card={card} />)}</div>
      </div>
    </section>
    <section class="assessment-outcome" id="outcome" aria-labelledby="assessment-outcome-title">
      <div class="container"><h2 class="kicker assessment-section-label" id="assessment-outcome-title">{c.outcome.eyebrow}</h2></div>
      <ProductShowcase locale={locale} />
    </section>
    <section class="assessment-science" id="science" aria-labelledby="assessment-science-title">
      <div class="container assessment-science-grid">
        <h2 class="kicker assessment-section-label" id="assessment-science-title">{c.science.eyebrow}</h2>
        <div class="assessment-science-copy" data-assessment-reveal>
          <p>{c.science.body}</p>
          <p class="assessment-science-note">{c.science.note}</p>
          <ol class="assessment-evidence" aria-label={c.science.evidenceLabel}>
            {evidence.map((label, index) => <li><span>{label}</span>{index < evidence.length - 1 && <span class="evidence-arrow" aria-hidden="true">&#8594;</span>}</li>)}
          </ol>
        </div>
      </div>
    </section>
    <section class="assessment-contact" id="contact" aria-labelledby="assessment-contact-title">
      <div class="container" data-assessment-reveal>
        <p class="kicker assessment-section-label">{c.contact.eyebrow}</p>
        <h2 class="serif" id="assessment-contact-title">{c.contact.title}</h2>
        <div class="assessment-contact-copy">{c.contact.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
        <a class="button-link assessment-gold-button" href={localePath('connect/', locale)}>{c.contact.action}<span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>
  </main>
</EditorialLayout>
<script>
  const assessment = document.querySelector('.assessment-page');
  if (assessment && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('assessment-arrived');
        observer.unobserve(entry.target);
      }
    }), { threshold: .12 });
    assessment.querySelectorAll('[data-assessment-reveal]').forEach(element => observer.observe(element));
  }
</script>
