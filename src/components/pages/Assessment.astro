---
import { translate, localePath, type Locale } from '../../i18n';
import { getArticles, articleSlug } from '../../lib/articles';
const { locale = 'sv' } = Astro.props as { locale: Locale };
const t = (text: string) => translate(locale, text);
const href = (route = '') => localePath(route, locale);
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { sitePath } from '../../lib/paths';
---
<EditorialLayout locale={locale} title={t("Assessment - 46K")} description={t("Our research and development approach to cognitive assessment in football.")}>
  <main id="main-content">
    <section class="page-intro container"><p class="kicker">{t("RESEARCH & DEVELOPMENT")}</p><span class="line"></span><h1 class="serif">{t("Assessment.")}</h1><p class="page-deck">{t("More information. Better questions.")}</p><p class="prose">{t("We are developing approaches to assess relevant cognitive abilities in football. The work is at an early stage, and validation is essential. Assessment should complement coaching, observation and match data.")}</p></section>
    <section class="content-band"><div class="container two-column"><h2 class="serif">{t("From measurement")}<br />{t("to development.")}</h2><div class="prose"><p>{t("A score is a starting point for a conversation. Its value depends on what it measures, how reliably it does so, and whether it helps us understand a player in context.")}</p><p>{t("Our aim is to connect responsible assessment with useful questions about learning, training and development. We do not claim that a cognitive test can determine who will become a professional footballer.")}</p><a class="text-link" href={href('explore/?category=ASSESS')}>{t("Read our assessment thinking")} <span aria-hidden="true">&#8599;</span></a></div></div></section>
    <section class="page-close container"><p class="kicker">{t("FOR COACHES, CLUBS & RESEARCHERS")}</p><h2 class="serif">{t("Help ask the next question.")}</h2><a class="button-link" href={href('connect/')}>{t("Start a conversation")} <span aria-hidden="true">&#8599;</span></a></section>
  </main>
</EditorialLayout>
