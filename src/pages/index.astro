---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import { getCollection } from 'astro:content';
import { sitePath } from '../lib/paths';
const features = [
  { name: 'UNDERSTAND', body: 'Look beyond what happens on the pitch. Explore perception, cognition and the questions behind football intelligence.', path: 'explore/', link: 'Explore our thinking' },
  { name: 'ASSESS', body: 'We are developing ways to examine relevant cognitive capabilities. Research and validation come first.', path: 'assessment/', link: 'Our approach to assessment' },
  { name: 'DEVELOP', body: 'Turn insights into better questions about training and development. Measurement should lead somewhere useful.', path: 'explore/?category=DEVELOP', link: 'Explore development' },
];
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<EditorialLayout>
  <main id="main-content">
    <section class="home-hero">
      <img class="hero-image" src={sitePath('images/football-attention-editorial.webp')} alt="Illustrative image of an adult football player looking across a training pitch." width="1536" height="1024" fetchpriority="high" />
      <div class="container hero-content">
        <p class="kicker">46K / SWEDEN / FOOTBALL INTELLIGENCE</p>
        <span class="line"></span>
        <h1 class="serif">Football<br />intelligence.</h1>
        <p class="hero-statement">Talent is more than<br />what you can see today.</p>
        <p class="hero-deck">We use cognitive science to understand and develop football intelligence.</p>
        <a class="button-link" href={sitePath('explore/')}>Explore our thinking <span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>
    <section class="home-model container">
      <p class="kicker">A WAY OF THINKING</p>
      <div class="model-grid">{features.map((feature, index) => <article>
        <span class="step-number">0{index + 1}</span><h2>{feature.name}</h2><p>{feature.body}</p><a class="text-link" href={sitePath(feature.path)}>{feature.link} <span aria-hidden="true">&#8599;</span></a>
      </article>)}</div>
    </section>
    <section class="home-journal container">
      <div class="section-heading"><div><p class="kicker">THE JOURNAL</p><h2 class="serif">Questions worth asking.</h2></div><a class="text-link" href={sitePath('explore/')}>All articles <span aria-hidden="true">&#8599;</span></a></div>
      <div class="article-grid">{articles.map(article => <article class="article-card"><p class="meta">{article.data.category} / {article.data.readingTime} MIN READ</p><h3><a href={sitePath('explore/' + article.id + '/')}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="read" href={sitePath('explore/' + article.id + '/')}>Read article <span aria-hidden="true">&#8599;</span></a></article>)}</div>
    </section>
    <section class="mission-band"><div class="container"><p class="kicker">THE 2046 MISSION</p><span class="line"></span><h2 class="serif">Sweden.<br />World Champions.<br />2046.</h2><p>2046 is not a prediction. It is a direction.</p><a class="text-link" href={sitePath('mission/')}>Explore the ambition <span aria-hidden="true">&#8599;</span></a></div></section>
  </main>
</EditorialLayout>
