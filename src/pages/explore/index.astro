---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { getCollection } from 'astro:content';
import { sitePath } from '../../lib/paths';
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const cats=['ALL','UNDERSTAND','ASSESS','DEVELOP','2046'];
---
<EditorialLayout title="Explore — 46K" description="Ideas, research and perspectives on football intelligence.">
<main id="main-content" class="container"><section class="journal-intro"><div class="kicker">46K / THE JOURNAL</div><span class="line"></span><h1 class="serif">Explore.</h1><p>Better questions. Deeper understanding. New perspectives on the unseen side of football.</p></section>
<nav class="filters" aria-label="Article categories">{cats.map(c=><a href={sitePath(c==='ALL'?'explore/':'explore/?category='+c)} data-cat={c} aria-current={c==='ALL'?'page':undefined}>{c}</a>)}</nav>
<p id="empty-category" class="empty-state" hidden role="status">No articles in this category yet. <a class="text-link" href={sitePath('explore/')}>Explore all articles</a></p>
<div class="article-grid" id="articles">{articles.map(article=><article class="article-card" data-category={article.data.category}><div class="meta">{article.data.category} / {article.data.type.toUpperCase()} / {article.data.readingTime} MIN</div><h2><a href={sitePath('explore/'+article.id+'/')}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="read" href={sitePath('explore/'+article.id+'/')}>READ ARTICLE ↗</a></article>)}</div>
</main>
<script>
  const categories = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-cat]')).map(link => link.dataset.cat);
  const requested = new URLSearchParams(window.location.search).get('category')?.toUpperCase() ?? 'ALL';
  const category = categories.includes(requested) ? requested : 'ALL';
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  let visible = 0;
  cards.forEach(card => {
    card.hidden = category !== 'ALL' && card.dataset.category !== category;
    if (!card.hidden) visible++;
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-cat]').forEach(link => {
    if (link.dataset.cat === category) link.setAttribute('aria-current', 'page');
    else link.removeAttribute('aria-current');
  });
  const empty = document.getElementById('empty-category');
  if (empty) empty.hidden = visible !== 0;
</script>
<style>.article-card[hidden]{display:none}</style>
</EditorialLayout>
