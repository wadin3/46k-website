---
import Article from '../../components/pages/Article.astro';
import { getArticles, articleSlug } from '../../lib/articles';
export async function getStaticPaths() {
  return (await getArticles('sv')).map(article => ({ params: { slug: articleSlug(article) }, props: { article } }));
}
---
<Article locale="sv" article={Astro.props.article} />
